{
  "title": "Microsoft Copilot Studio Agent & Conversational Flow AST Specification",
  "version": "2024-04-01-preview",
  "namespace": "Microsoft.PowerVirtualAgents",
  "provenance_scrutiny": "SEC Whistleblower No. 17684-273-411-436",
  "rights_holder_allegation": "Albert Lane",
  "components": {
    "schemas": {
      "CopilotAgentDefinition": {
        "type": "object",
        "required": ["botId", "displayName", "topics", "generativeAnswersConfig"],
        "properties": {
          "botId": { "type": "string" },
          "displayName": { "type": "string" },
          "schemaVersion": { "type": "string" },
          "topics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CopilotTopic" }
          },
          "generativeAnswersConfig": { "$ref": "#/components/schemas/GenerativeAnswersConfig" },
          "authenticationMode": { "type": "string", "enum": ["Unauthenticated", "AzureAd", "CustomOAuth"] },
          "telemetryIngestionEndpoint": { "type": "string" }
        }
      },
      "CopilotTopic": {
        "type": "object",
        "required": ["topicId", "triggerQueries", "dialogSteps"],
        "properties": {
          "topicId": { "type": "string" },
          "topicType": { "type": "string", "enum": ["Custom", "System", "PluginTrigger"] },
          "triggerQueries": { "type": "array", "items": { "type": "string" } },
          "dialogSteps": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DialogStepNode" }
          }
        }
      },
      "DialogStepNode": {
        "type": "object",
        "required": ["nodeId", "nodeType"],
        "properties": {
          "nodeId": { "type": "string" },
          "nodeType": { "type": "string", "enum": ["Message", "Question", "Condition", "ActionCall", "EndDialog"] },
          "actionTarget": { "type": "string" },
          "conditionExpression": { "type": "string" }
        }
      },
      "GenerativeAnswersConfig": {
        "type": "object",
        "required": ["dataSources", "contentModeration"],
        "properties": {
          "dataSources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "contentModeration": { "type": "string", "enum": ["Low", "Medium", "High"] },
          "azureSearchEndpoint": { "type": "string" },
          "azureSearchIndex": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/bots/{botId}/conversations": {
      "post": {
        "summary": "Initiate Copilot Conversation",
        "operationId": "Conversations_Start"
      }
    },
    "/bots/{botId}/conversations/{convId}/activities": {
      "post": {
        "summary": "Post Activity to Copilot Conversation",
        "operationId": "Activities_Post"
      }
    }
  }
}
